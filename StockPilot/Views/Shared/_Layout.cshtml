
<!DOCTYPE html>

<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - StockPilot
    </title>


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>


@if (User.Identity != null &&
     User.Identity.IsAuthenticated)
{
    <div class="app-layout">


        <!-- SIDEBAR -->

        <aside class="sidebar">


            <!-- BRAND -->

            <div class="brand">

                <div class="brand-icon">
                    SP
                </div>

                <div>

                    <div class="brand-name">
                        StockPilot
                    </div>

                    <div class="brand-subtitle">
                        Inventory System
                    </div>

                </div>

            </div>


            <!-- MAIN MENU -->

            <div class="sidebar-section">

                <span>
                    MAIN MENU
                </span>

            </div>


            <nav class="sidebar-nav">


                <!-- DASHBOARD -->

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-item">

                    <span class="nav-icon">
                        ⌂
                    </span>

                    <span>
                        Dashboard
                    </span>

                </a>


                @if (User.IsInRole("Admin"))
                {

                    <!-- PRODUCTS -->

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="nav-item">

                        <span class="nav-icon">
                            ▣
                        </span>

                        <span>
                            Products
                        </span>

                    </a>


                    <!-- CATEGORIES -->

                    <a asp-controller="Category"
                       asp-action="Index"
                       class="nav-item">

                        <span class="nav-icon">
                            ▤
                        </span>

                        <span>
                            Categories
                        </span>

                    </a>


                    <!-- BILLING -->

                    <a asp-controller="Billing"
                       asp-action="Index"
                       class="nav-item">

                        <span class="nav-icon">
                            ₹
                        </span>

                        <span>
                            Billing
                        </span>

                    </a>


                    <!-- SALES -->

                    <a asp-controller="Sales"
                       asp-action="Index"
                       class="nav-item">

                        <span class="nav-icon">
                            ▥
                        </span>

                        <span>
                            Sales
                        </span>

                    </a>


                    <!-- NEW ORDERS -->

                    <a asp-controller="Sales"
                       asp-action="PendingOrders"
                       class="nav-item">

                        <span class="nav-icon">
                            🔔
                        </span>

                        <span>
                            New Orders
                        </span>

                    </a>

                }


                @if (User.IsInRole("User"))
                {

                    <!-- SHOP -->

                    <a asp-controller="Shop"
                       asp-action="Index"
                       class="nav-item">

                        <span class="nav-icon">
                            🛒
                        </span>

                        <span>
                            Shop
                        </span>

                    </a>


                    <!-- MY CART -->

                    <a asp-controller="Shop"
                       asp-action="Cart"
                       class="nav-item">

                        <span class="nav-icon">
                            🛍
                        </span>

                        <span>
                            My Cart
                        </span>

                    </a>


                    <!-- MY ORDERS -->

                    <a asp-controller="Shop"
                       asp-action="MyOrders"
                       class="nav-item">

                        <span class="nav-icon">
                            ▥
                        </span>

                        <span>
                            My Orders
                        </span>

                    </a>

                }


            </nav>


            <!-- ACCOUNT -->

            <div class="sidebar-bottom">


                <div class="sidebar-section">

                    <span>
                        ACCOUNT
                    </span>

                </div>


                <div class="user-mini">


                    <div class="user-avatar">

                        @if (!string.IsNullOrEmpty(User.Identity.Name))
                        {
                            @User.Identity.Name.Substring(0, 1).ToUpper()
                        }

                    </div>


                    <div class="user-info">

                        <strong>
                            @User.Identity.Name
                        </strong>


                        <span>

                            @if (User.IsInRole("Admin"))
                            {
                                <text>Administrator</text>
                            }
                            else
                            {
                                <text>User</text>
                            }

                        </span>

                    </div>


                </div>


                <!-- LOGOUT -->

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="logout-link">

                    <span>
                        ↪
                    </span>

                    Logout

                </a>


            </div>


        </aside>


        <!-- MAIN CONTENT -->

        <main class="main-content">


            <!-- TOP BAR -->

            <header class="topbar">


                <div class="mobile-brand">

                    <strong>
                        StockPilot
                    </strong>

                </div>


                <div class="topbar-right">


                    <div class="welcome-text">

                        Welcome,

                        <strong>
                            @User.Identity.Name
                        </strong>

                    </div>


                    <div class="top-avatar">

                        @if (!string.IsNullOrEmpty(User.Identity.Name))
                        {
                            @User.Identity.Name.Substring(0, 1).ToUpper()
                        }

                    </div>


                </div>


            </header>


            <!-- PAGE CONTENT -->

            <section class="content-area">

                @RenderBody()

            </section>


            <!-- FOOTER -->

            <footer class="app-footer">

                <span>
                    © @DateTime.Now.Year StockPilot
                </span>

                <span>
                    Inventory Management System
                </span>

            </footer>


        </main>


    </div>
}
else
{
    <!-- AUTHENTICATION PAGES -->

    <main class="auth-layout">

        @RenderBody()

    </main>
}


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


@await RenderSectionAsync(
    "Scripts",
    required: false)


</body>

</html>