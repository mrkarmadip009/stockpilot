<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />


<title>@ViewData["Title"] - StockPilot</title>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />


</head>

<body>


@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="app-layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                <div class="brand-icon">
                    SP
                </div>

                <div>
                    <div class="brand-name">StockPilot</div>
                    <div class="brand-subtitle">
                        Inventory System
                    </div>
                </div>
            </div>

            <div class="sidebar-section">
                <span>MAIN MENU</span>
            </div>

          <nav class="sidebar-nav">


<a asp-controller="Dashboard"
   asp-action="Index"
   class="nav-item">

    <span class="nav-icon">⌂</span>
    <span>Dashboard</span>

</a>


<a asp-controller="Product"
   asp-action="Index"
   class="nav-item">

    <span class="nav-icon">▣</span>
    <span>Products</span>

</a>


<a asp-controller="Category"
   asp-action="Index"
   class="nav-item">

    <span class="nav-icon">▤</span>
    <span>Categories</span>

</a>


@if (User.IsInRole("Admin"))
{
    <a href="#"
       class="nav-item">

        <span class="nav-icon">₹</span>
        <span>Billing</span>

    </a>

    <a href="#"
       class="nav-item">

        <span class="nav-icon">▥</span>
        <span>Sales</span>

    </a>
}


</nav>

            <div class="sidebar-bottom">

                <div class="sidebar-section">
                    <span>ACCOUNT</span>
                </div>

                <div class="user-mini">

                    <div class="user-avatar">
                        @User.Identity.Name?.Substring(0, 1).ToUpper()
                    </div>

                    <div class="user-info">
                        <strong>@User.Identity.Name</strong>

                        <span>
                            @(User.IsInRole("Admin") ? "Administrator" : "User")
                        </span>
                    </div>

                </div>

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="logout-link">
                    <span>↪</span>
                    Logout
                </a>

            </div>

        </aside>

        <!-- MAIN -->
        <main class="main-content">

            <!-- TOP BAR -->
            <header class="topbar">

                <div class="mobile-brand">
                    <strong>StockPilot</strong>
                </div>

                <div class="topbar-right">

                    <div class="welcome-text">
                        Welcome,
                        <strong>@User.Identity.Name</strong>
                    </div>

                    <div class="top-avatar">
                        @User.Identity.Name?.Substring(0, 1).ToUpper()
                    </div>

                </div>

            </header>

            <!-- PAGE CONTENT -->
            <section class="content-area">

                @RenderBody()

            </section>

            <footer class="app-footer">
                <span>© @DateTime.Now.Year StockPilot</span>
                <span>Inventory Management System</span>
            </footer>

        </main>

    </div>
}
else
{
    <!-- AUTHENTICATION PAGES -->
    <main class="auth-layout">
        @RenderBody()
    </main>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)


</body>
</html>
