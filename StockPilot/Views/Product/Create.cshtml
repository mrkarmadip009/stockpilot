
@model StockPilot.Models.Product

@{
    ViewData["Title"] = "Add Product";
}


<div class="page-header">

    <div>

        <div class="dashboard-eyebrow">
            STOCKPILOT INVENTORY
        </div>

        <h1>
            Add Product
        </h1>

        <p>
            Add a new product or add stock to an existing product.
        </p>

    </div>


    <div>

        <a asp-action="Index"
           class="btn btn-secondary">

            ← Products

        </a>

    </div>

</div>


<!-- SUCCESS MESSAGE -->

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">

        @TempData["Message"]

    </div>
}


<!-- ========================= -->
<!-- EXISTING PRODUCT SEARCH -->
<!-- ========================= -->

<div class="form-card mb-4">

    <h3>
        Add Stock to Existing Product
    </h3>

    <p class="text-muted">
        Start typing the product name and select the product.
    </p>


    <div class="form-group">

        <label>
            Search Product
        </label>


        <input type="text"
               id="productSearch"
               class="form-control"
               placeholder="Example: mul"
               autocomplete="off" />


        <!-- SUGGESTIONS -->

        <div id="productSuggestions"
             class="list-group mt-1">
        </div>

    </div>


    <!-- SELECTED PRODUCT -->

    <div id="selectedProduct"
         style="display:none;">

        <hr />


        <h4>
            Selected Product
        </h4>


        <div class="form-group">

            <label>
                Product Name
            </label>

            <input type="text"
                   id="selectedName"
                   class="form-control"
                   readonly />

        </div>


        <div class="form-row">

            <div class="form-group">

                <label>
                    Current Stock
                </label>

                <input type="text"
                       id="selectedStock"
                       class="form-control"
                       readonly />

            </div>


            <div class="form-group">

                <label>
                    Buying Price
                </label>

                <input type="text"
                       id="selectedBuyingPrice"
                       class="form-control"
                       readonly />

            </div>


            <div class="form-group">

                <label>
                    Selling Price
                </label>

                <input type="text"
                       id="selectedSellingPrice"
                       class="form-control"
                       readonly />

            </div>

        </div>


        <!-- ADD STOCK FORM -->

        <form asp-controller="Product"
              asp-action="AddExistingStock"
              method="post">

            @Html.AntiForgeryToken()


            <input type="hidden"
                   id="selectedProductId"
                   name="productId" />


            <div class="form-group">

                <label>
                    Add Stock Quantity
                </label>

                <input type="number"
                       name="quantity"
                       min="1"
                       value="1"
                       class="form-control"
                       required />

            </div>


            <div class="form-actions">

                <button type="submit"
                        class="btn btn-primary">

                    + Add Stock

                </button>

            </div>


        </form>

    </div>

</div>


<!-- ========================= -->
<!-- CREATE NEW PRODUCT -->
<!-- ========================= -->

<div class="form-card">

    <h3>
        Create New Product
    </h3>

    <p class="text-muted">
        Use this form only when the product does not already exist.
    </p>


    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">


        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>


        <!-- PRODUCT NAME -->

        <div class="form-group">

            <label asp-for="Name">
                Product Name
            </label>


            <input asp-for="Name"
                   class="form-control"
                   placeholder="Enter product name" />


            <span asp-validation-for="Name"
                  class="text-danger">
            </span>

        </div>


        <!-- CATEGORY -->

        <div class="form-group">

            <label>
                Category
            </label>


            <select asp-for="CategoryId"
                    asp-items="ViewBag.Categories"
                    class="form-control">

                <option value="">
                    Select Category
                </option>

            </select>


            <span asp-validation-for="CategoryId"
                  class="text-danger">
            </span>

        </div>


        <!-- STOCK + BUYING PRICE -->

        <div class="form-row">

            <div class="form-group">

                <label asp-for="StockQuantity">
                    Stock Quantity
                </label>


                <input asp-for="StockQuantity"
                       type="number"
                       min="0"
                       class="form-control"
                       placeholder="Enter quantity" />


                <span asp-validation-for="StockQuantity"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="BuyingPrice">
                    Buying Price
                </label>


                <input asp-for="BuyingPrice"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       placeholder="Internal buying price" />


                <span asp-validation-for="BuyingPrice"
                      class="text-danger">
                </span>

            </div>

        </div>


        <!-- SELLING PRICE -->

        <div class="form-group">

            <label asp-for="SellingPrice">
                Selling Price
            </label>


            <input asp-for="SellingPrice"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control"
                   placeholder="Customer price" />


            <span asp-validation-for="SellingPrice"
                  class="text-danger">
            </span>

        </div>


        <!-- PRODUCT PHOTO -->

        <div class="form-group">

            <label>
                Product Photo
            </label>


            <input type="file"
                   name="imageFile"
                   class="form-control"
                   accept="image/*" />


            <small class="form-help">
                Upload a product image.
            </small>

        </div>


        <!-- DESCRIPTION -->

        <div class="form-group">

            <label asp-for="Description">
                Description
            </label>


            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      placeholder="Enter product description"></textarea>

        </div>


        <!-- BUTTONS -->

        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary">

                + Add Product

            </button>


            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </div>


    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        var searchBox =
            document.getElementById("productSearch");

        var suggestions =
            document.getElementById("productSuggestions");

        var selectedProduct =
            document.getElementById("selectedProduct");


        searchBox.addEventListener(
            "input",
            function ()
            {
                var text =
                    searchBox.value.trim();


                suggestions.innerHTML = "";


                selectedProduct.style.display =
                    "none";


                if (text.length < 1)
                {
                    return;
                }


                fetch(
                    '@Url.Action("SearchExistingProducts", "Product")?term='
                    + encodeURIComponent(text)
                )
                .then(function (response)
                {
                    return response.json();
                })
                .then(function (products)
                {

                    suggestions.innerHTML = "";


                    if (products.length === 0)
                    {
                        var noResult =
                            document.createElement("div");

                        noResult.className =
                            "list-group-item text-muted";

                        noResult.innerText =
                            "No product found.";

                        suggestions.appendChild(
                            noResult
                        );

                        return;
                    }


                    products.forEach(
                        function (product)
                        {

                            var item =
                                document.createElement("button");


                            item.type = "button";

                            item.className =
                                "list-group-item list-group-item-action";


                            item.innerHTML =
                                "<strong>"
                                + product.name
                                + "</strong>"
                                + " - Stock: "
                                + product.stock;


                            item.addEventListener(
                                "click",
                                function ()
                                {
                                    selectProduct(
                                        product
                                    );
                                }
                            );


                            suggestions.appendChild(
                                item
                            );

                        }
                    );

                })
                .catch(function ()
                {

                    suggestions.innerHTML =
                        "<div class='list-group-item text-danger'>"
                        + "Unable to search products."
                        + "</div>";

                });

            }
        );


        function selectProduct(product)
        {

            document.getElementById(
                "selectedProductId"
            ).value =
                product.productId;


            document.getElementById(
                "selectedName"
            ).value =
                product.name;


            document.getElementById(
                "selectedStock"
            ).value =
                product.stock;


            document.getElementById(
                "selectedBuyingPrice"
            ).value =
                "₹"
                + Number(
                    product.buyingPrice
                ).toFixed(2);


            document.getElementById(
                "selectedSellingPrice"
            ).value =
                "₹"
                + Number(
                    product.sellingPrice
                ).toFixed(2);


            selectedProduct.style.display =
                "block";


            searchBox.value =
                product.name;


            suggestions.innerHTML =
                "";

        }

    </script>

}