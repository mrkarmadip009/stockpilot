@model StockPilot.Models.Product

@{
ViewData["Title"] = "Add Product";
}

<div class="page-header">


<div>
    <div class="dashboard-eyebrow">
        STOCKPILOT INVENTORY
    </div>

    <h1>Add Product</h1>

    <p>
        Add a new product to your inventory.
    </p>
</div>

<div>
    <a asp-action="Index"
       class="btn btn-secondary">
        ← Products
    </a>
</div>


</div>

<div class="form-card">


<form asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="form-group">

        <label asp-for="Name">
            Product Name
        </label>

        <input asp-for="Name"
               class="form-control"
               placeholder="Enter product name" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>

    </div>

    <div class="form-group">

        <label>
            Category
        </label>

        <select asp-for="CategoryId"
                asp-items="ViewBag.Categories"
                class="form-control">

            <option value="">
                Select Category
            </option>

        </select>

        <span asp-validation-for="CategoryId"
              class="text-danger">
        </span>

    </div>

    <div class="form-row">

        <div class="form-group">

            <label asp-for="StockQuantity">
                Stock Quantity
            </label>

            <input asp-for="StockQuantity"
                   type="number"
                   min="0"
                   class="form-control"
                   placeholder="Enter quantity" />

            <span asp-validation-for="StockQuantity"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="BuyingPrice">
                Buying Price
            </label>

            <input asp-for="BuyingPrice"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control"
                   placeholder="Internal buying price" />

            <span asp-validation-for="BuyingPrice"
                  class="text-danger">
            </span>

        </div>

    </div>

    <div class="form-group">

        <label asp-for="SellingPrice">
            Selling Price
        </label>

        <input asp-for="SellingPrice"
               type="number"
               step="0.01"
               min="0"
               class="form-control"
               placeholder="Customer price" />

        <span asp-validation-for="SellingPrice"
              class="text-danger">
        </span>

    </div>

    <div class="form-group">

        <label>
            Product Photo
        </label>

        <input type="file"
               name="imageFile"
               class="form-control"
               accept="image/*" />

        <small class="form-help">
            Upload a product image.
        </small>

    </div>

    <div class="form-group">

        <label asp-for="Description">
            Description
        </label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="4"
                  placeholder="Enter product description">
        </textarea>

    </div>

    <div class="form-actions">

        <button type="submit"
                class="btn btn-primary">
            + Add Product
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </div>

</form>


</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
