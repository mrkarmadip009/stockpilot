@model StockPilot.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this product?
</div>

<div class="card">
    <div class="card-body">

        <h4>@Model.Name</h4>

        <p>
            <strong>Stock:</strong>
            @Model.StockQuantity
        </p>

        <p>
            <strong>Selling Price:</strong>
            ₹@Model.SellingPrice
        </p>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="ProductId" />

            <button type="submit"
                    class="btn btn-danger">
                Yes, Delete
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>