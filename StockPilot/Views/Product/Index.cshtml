@model IEnumerable<StockPilot.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Product</a>
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Stock</th>
            <th>Buying Price</th>
            <th>Selling Price</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>

                <td>
                    @item.Category?.Name
                </td>

                <td>
                    @item.StockQuantity
                </td>

               <td>₹@item.BuyingPrice.ToString("N2")</td>

                <td>₹@item.SellingPrice.ToString("N2")</td>
                <td>
                    @(item.IsActive ? "Yes" : "No")
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.ProductId"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.ProductId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.ProductId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>

</table>