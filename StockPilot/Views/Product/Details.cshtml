@model StockPilot.Models.Product

@{
ViewData["Title"] = "Product Details";
bool isAdmin = User.IsInRole("Admin");
}

<div class="page-header">
    <div>
        <div class="dashboard-eyebrow">
            STOCKPILOT INVENTORY
        </div>


    <h1>Product Details</h1>

    <p>View product information and current stock.</p>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">
        ← Products
    </a>
</div>


</div>

<div class="details-card">


@if (!string.IsNullOrEmpty(Model.ImagePath))
{
    <div style="text-align:center; margin-bottom:25px;">
        <img src="@Model.ImagePath"
             alt="@Model.Name"
             style="width:220px; height:180px; object-fit:cover; border-radius:14px;" />
    </div>
}

<div class="details-row">
    <div class="details-label">Product Name</div>
    <div class="details-value">@Model.Name</div>
</div>

<div class="details-row">
    <div class="details-label">Category</div>
    <div class="details-value">@Model.Category?.Name</div>
</div>

<div class="details-row">
    <div class="details-label">Stock Quantity</div>
    <div class="details-value">@Model.StockQuantity</div>
</div>

<div class="details-row">
    <div class="details-label">Price</div>
    <div class="details-value">
        ₹@Model.SellingPrice.ToString("0.##")
    </div>
</div>

@if (isAdmin)
{
    <div class="details-row">
        <div class="details-label">Buying Price</div>
        <div class="details-value">
            ₹@Model.BuyingPrice.ToString("0.##")
        </div>
    </div>

    <div class="details-row">
        <div class="details-label">Profit Per Item</div>
        <div class="details-value">
            ₹@((Model.SellingPrice - Model.BuyingPrice).ToString("0.##"))
        </div>
    </div>
}

<div class="details-row">
    <div class="details-label">Description</div>
    <div class="details-value">
        @Model.Description
    </div>
</div>

<div class="details-actions">

    @if (isAdmin)
    {
        <a asp-action="Edit"
           asp-route-id="@Model.ProductId"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.ProductId"
           class="btn btn-danger">
            Delete
        </a>
    }

    <a asp-action="Index"
       class="btn btn-secondary">
        ← Back
    </a>

</div>


</div>
