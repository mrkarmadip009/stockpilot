
@model IEnumerable<StockPilot.Models.Sale>

@{
    ViewData["Title"] = "My Orders";
}

<div style="padding:25px;">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:25px;">

        <div>
            <h1>My Orders</h1>
            <p style="color:#777;">
                View your previous purchases.
            </p>
        </div>

        <a asp-controller="Shop"
           asp-action="Index"
           style="background:#6c5ce7; color:white; padding:11px 20px; border-radius:7px; text-decoration:none;">
            🛍️ Shop
        </a>

    </div>

    @if (!Model.Any())
    {
        <div style="background:white; padding:40px; border-radius:12px; text-align:center;">

            <h2>No orders yet.</h2>

            <p style="color:#777;">
                Your purchased products will appear here.
            </p>

            <a asp-controller="Shop"
               asp-action="Index"
               style="display:inline-block; margin-top:15px; background:#6c5ce7; color:white; padding:12px 20px; border-radius:7px; text-decoration:none;">
                Start Shopping
            </a>

        </div>
    }
    else
    {
        <div style="background:white; border-radius:12px; padding:20px; overflow-x:auto;">

            <table style="width:100%; border-collapse:collapse;">

                <thead>
                    <tr style="background:#f5f5f5;">

                        <th style="padding:14px; text-align:left;">
                            Order ID
                        </th>

                        <th style="padding:14px; text-align:left;">
                            Date
                        </th>

                        <th style="padding:14px; text-align:left;">
                            Total Amount
                        </th>

                        <th style="padding:14px; text-align:left;">
                            Action
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var sale in Model)
                    {
                        <tr style="border-bottom:1px solid #eee;">

                            <td style="padding:14px;">
                                #@sale.SaleId
                            </td>

                            <td style="padding:14px;">
                                @sale.SaleDate.ToString("dd-MM-yyyy hh:mm tt")
                            </td>

                            <td style="padding:14px;">
                                <strong>
                                    ₹@sale.TotalAmount.ToString("0.00")
                                </strong>
                            </td>

                            <td style="padding:14px;">

                                <a asp-action="OrderDetails"
                                   asp-route-id="@sale.SaleId"
                                   style="background:#6c5ce7; color:white; padding:8px 14px; border-radius:6px; text-decoration:none;">
                                    View Details
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
