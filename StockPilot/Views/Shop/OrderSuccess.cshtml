@{
ViewData["Title"] = "Order Successful";
}

<div class="container-fluid">


<div class="card shadow-sm text-center p-5">

    <h1 class="text-success">
        ✓ Order Successful
    </h1>

    <p class="mt-3">
        Thank you for your purchase.
    </p>

    <p>
        Your Sale ID is:
        <strong>#@ViewBag.SaleId</strong>
    </p>

    <div class="mt-4">

        <a asp-controller="Shop"
           asp-action="Index"
           class="btn btn-primary">
            Continue Shopping
        </a>

        <a asp-controller="Sales"
           asp-action="Index"
           class="btn btn-outline-secondary ms-2">
            View Sales
        </a>

    </div>

</div>


</div>
