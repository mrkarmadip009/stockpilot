
@model StockPilot.Models.Sale

@{
    ViewData["Title"] = "Order Details";
}

<div style="padding:25px;">

    <div style="background:white; border-radius:12px; padding:30px; max-width:900px; margin:auto;">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:25px;">

            <div>
                <h1>Order #@Model.SaleId</h1>
                <p style="color:#777;">
                    @Model.SaleDate.ToString("dd-MM-yyyy hh:mm tt")
                </p>
            </div>

            <a asp-action="MyOrders"
               style="background:#eee; color:#333; padding:10px 18px; border-radius:7px; text-decoration:none;">
                ← My Orders
            </a>

        </div>

        <p>
            <strong>Customer:</strong>
            @Model.CustomerName
        </p>

        <hr />

        <h3>Products</h3>

        <table style="width:100%; border-collapse:collapse; margin-top:15px;">

            <thead>
                <tr style="background:#f5f5f5;">

                    <th style="padding:12px; text-align:left;">
                        Product
                    </th>

                    <th style="padding:12px;">
                        Quantity
                    </th>

                    <th style="padding:12px;">
                        Price
                    </th>

                    <th style="padding:12px;">
                        Total
                    </th>

                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model.Items)
                {
                    <tr style="border-bottom:1px solid #eee;">

                        <td style="padding:12px;">
                            @(item.Product?.Name ?? "Product")
                        </td>

                        <td style="padding:12px; text-align:center;">
                            @item.Quantity
                        </td>

                        <td style="padding:12px; text-align:center;">
                            ₹@item.PriceAtSale.ToString("0.00")
                        </td>

                        <td style="padding:12px; text-align:center;">
                            ₹@item.Total.ToString("0.00")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <div style="text-align:right; margin-top:25px; font-size:22px;">

            <strong>
                Grand Total:
                <span style="color:#6c5ce7;">
                    ₹@Model.TotalAmount.ToString("0.00")
                </span>
            </strong>

        </div>

    </div>

</div>