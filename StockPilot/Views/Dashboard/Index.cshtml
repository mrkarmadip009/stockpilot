@model StockPilot.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">StockPilot Dashboard</h1>

<div class="row">

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Total Products</h5>
                <h2>@Model.TotalProducts</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Total Categories</h5>
                <h2>@Model.TotalCategories</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Total Stock</h5>
                <h2>@Model.TotalStock</h2>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Low Stock Products</h5>
                <h2>@Model.LowStockProducts</h2>
                <p>Products with stock below 10</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Total Inventory Value</h5>
                <h2>₹ @Model.TotalInventoryValue</h2>
            </div>
        </div>
    </div>

</div>

<hr />

<a asp-controller="Product"
   asp-action="Index"
   class="btn btn-primary">
    Manage Products
</a>

<a asp-controller="Category"
   asp-action="Index"
   class="btn btn-secondary">
    Manage Categories
</a>