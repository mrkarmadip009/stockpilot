@model StockPilot.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<h1>Category Details</h1>

<div class="card">

    <div class="card-body">

        <h4>Category</h4>

        <hr />

        <p>
            <strong>ID:</strong>
            @Model.CategoryId
        </p>

        <p>
            <strong>Name:</strong>
            @Model.Name
        </p>

        <p>
            <strong>Total Products:</strong>
            @Model.Products.Count
        </p>

    </div>

</div>

<br />

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>