@model StockPilot.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<h1>Edit Category</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="CategoryId" />

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">

        <label asp-for="Name"
               class="form-label">
            Category Name
        </label>

        <input asp-for="Name"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-success">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>